  <a href="/posts" class="home-btn">← Back to Home</a>

  <h1>{{post.title}}</h1>

  <div class="meta-info">
    <strong>Author:</strong> {{post.author.name}}<br>
    {{#if post.openGraphMetadata.publishedTime}}
    <strong>Published:</strong> {{formatDate post.openGraphMetadata.publishedTime}}<br>
    {{/if}}
    {{#if post.categories}}
    <strong>Categories:</strong>
    {{#each post.categories}}
    <span class="badge">{{name}}</span>
    {{/each}}
    <br>
    {{/if}}
    {{#if post.openGraphMetadata.tags}}
    <strong>Tags:</strong>
    {{#each post.openGraphMetadata.tags}}
    <span class="badge">{{this}}</span>
    {{/each}}
    {{/if}}
  </div>

  {{#if post.openGraphMetadata.image}}
  <img src="{{post.openGraphMetadata.image}}" alt="{{#if post.openGraphMetadata.imageAlt}}{{post.openGraphMetadata.imageAlt}}{{else}}{{post.title}}{{/if}}" class="preview-image">
  {{/if}}

  {{#if post.openGraphMetadata.url}}
  <div class="share-buttons">
    <a href="https://www.facebook.com/sharer/sharer.php?u={{encodeURIComponent post.openGraphMetadata.url}}"
       class="share-btn facebook"
       target="_blank"
       rel="noopener">
      Share on Facebook
    </a>
    <a href="https://twitter.com/intent/tweet?url={{encodeURIComponent post.openGraphMetadata.url}}{{#if post.openGraphMetadata.title}}&text={{encodeURIComponent post.openGraphMetadata.title}}{{/if}}{{#if post.openGraphMetadata.twitterSite}}&via={{removeAt post.openGraphMetadata.twitterSite}}{{/if}}{{#if post.openGraphMetadata.tags}}&hashtags={{joinTags post.openGraphMetadata.tags}}{{/if}}"
       class="share-btn twitter"
       target="_blank"
       rel="noopener">
      Share on Twitter
    </a>
    <a href="https://www.linkedin.com/sharing/share-offsite/?url={{encodeURIComponent post.openGraphMetadata.url}}"
       class="share-btn linkedin"
       target="_blank"
       rel="noopener">
      Share on LinkedIn
    </a>
  </div>
  {{/if}}
 
  <div class="content">{{post.content}}</div>

  <h2>Testing Instructions</h2>
  <ol>
    <li><strong>Make public:</strong> <code>ngrok http 3000</code></li>
    <li><strong>Test share preview:</strong> Use Facebook Debugger, Twitter Validator, or LinkedIn Inspector</li>
  </ol>

  <div class="note">
    <strong>Note:</strong> Social media platforms need to be able to access this page publicly to read the OpenGraph metadata.
    Use ngrok or deploy to a hosting service to test the rich preview cards.
  </div>