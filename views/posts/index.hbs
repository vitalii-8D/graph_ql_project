<h1>Social Sharing Test Pages</h1>

<div class='intro'>
  <p>
    This is a collection of test pages for social sharing functionality with OpenGraph metadata. Each post below is
    dynamically rendered from your GraphQL database with complete OpenGraph tags.
  </p>
</div>

<div class='stats'>
  <strong>{{posts.length}} posts</strong>
  available for testing
</div>

<div class='instructions'>
  <h2>How to Test</h2>
  <ol>
    <li>Your NestJS app is serving these pages dynamically</li>
    <li>Make it public: <code>ngrok http 3000</code></li>
    <li>Click on any post below to view it</li>
    <li>Use the share buttons on each post page</li>
    <li>Validate with platform debuggers:
      <ul>
        <li>Facebook:
          <a
            href='https://developers.facebook.com/tools/debug/'
            target='_blank'
          >developers.facebook.com/tools/debug/</a></li>
        <li>Twitter:
          <a href='https://cards-dev.twitter.com/validator' target='_blank'>cards-dev.twitter.com/validator</a></li>
        <li>LinkedIn:
          <a href='https://www.linkedin.com/post-inspector/' target='_blank'>linkedin.com/post-inspector/</a></li>
      </ul>
    </li>
  </ol>
</div>

<div class='posts-grid'>
  {{#each posts}}
    <a href='/posts/{{id}}' class='post-card'>
      <h2>{{title}}</h2>
      <div class='meta'>
        <strong>By:</strong>
        {{author.name}}
        {{#if openGraphMetadata.publishedTime}}
          <br /><strong>Published:</strong>
          {{formatDate openGraphMetadata.publishedTime}}
        {{/if}}
      </div>
      <div class='description'>
        {{#if openGraphMetadata.description}}
          {{truncate openGraphMetadata.description 150}}...
        {{else}}
          {{truncate content 150}}...
        {{/if}}
      </div>
      <span class='type-badge'>{{#if openGraphMetadata.type}}{{openGraphMetadata.type}}{{else}}ARTICLE{{/if}}</span>
      {{#if openGraphMetadata.tags}}
        <div class='tags'>
          {{#each openGraphMetadata.tags}}
            <span class='tag'>{{this}}</span>
          {{/each}}
        </div>
      {{/if}}
    </a>
  {{/each}}
</div>